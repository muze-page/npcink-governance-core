{
  "name": "npcink/npcink-governance-core",
  "description": "WordPress AI operation governance layer for ability intake, proposals, approval boundaries, and audit logs.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Npcink\\GovernanceCore\\": "includes/"
    }
  },
  "scripts": {
    "analyse:phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
    "lint:php": "@php tests/lint.php",
    "smoke:wp": "bash tests/smoke-wp.sh",
    "smoke:wp-m4": "bash scripts/run-m4-wordpress-smoke.sh",
    "test:contracts": "@php tests/run.php",
    "test:fail-closed": "@php tests/fail-closed.php",
    "check:wporg": "@php scripts/check-wordpress-org-review-rules.php",
    "check:wordpress-smoke-evidence": "@php scripts/check-wordpress-smoke-evidence.php",
    "eval:lab": "sh scripts/eval-lab.sh",
    "eval:project:review": "sh scripts/eval-lab.sh task=project_boundary_review_triad \"project=$PWD\" project_label=npcink-governance-core contract=project_boundary_review_triad.v1 mode=working_diff",
    "eval:gutenberg:judge": "sh scripts/eval-lab.sh task=gutenberg_judge_cross",
    "test": [
      "@test:contracts",
      "@test:fail-closed"
    ],
    "package:release": "bash scripts/build-release-package.sh",
    "test:release-package": "bash tests/release-package-reproducibility.sh",
    "test:wordpress-smoke-evidence": "@php tests/wordpress-smoke-evidence.php",
    "prepare:release": "bash scripts/prepare-release.sh",
    "sync:wporg": "bash scripts/sync-wporg-svn.sh",
    "acceptance:cross-repo-release": "bash scripts/cross-repo-release-acceptance.sh",
    "rc:version-matrix": "bash scripts/check-release-candidate-version-matrix.sh",
    "plugin-check:release": "bash scripts/plugin-check-release.sh",
    "release:verify": [
      "@test:all",
      "@check:wporg",
      "@plugin-check:release"
    ],
    "release:verify:m4": [
      "@release:verify",
      "@check:wordpress-smoke-evidence"
    ],
    "test:all": [
      "@lint:php",
      "@test",
      "@test:release-package",
      "@test:wordpress-smoke-evidence"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0"
  }
}
